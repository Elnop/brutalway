{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["**/fixtures/**", "packages/tools/create-brutal/overlays/**", "templates/**", "site/**"],
  "workspaces": {
    ".": {},
    "packages/configs/oxlint-config-typescript": {
      "ignoreDependencies": ["@brutalway/eslint-plugin-file-named-after-export", "eslint-plugin-check-file", "eslint-plugin-no-comments"]
    },
    "packages/configs/oxlint-config-zustand": {
      "ignoreDependencies": ["@brutalway/eslint-plugin-store-layout"]
    },
    "packages/configs/dependency-cruiser-config": {
      "ignoreDependencies": ["@swc/core", "dependency-cruiser"]
    },
    "packages/configs/alint-config": {
      "ignoreDependencies": ["@asamarts/alint"]
    },
    "packages/tools/create-brutal": {
      "entry": ["src/cli.ts", "scripts/*.ts"]
    }
  }
}

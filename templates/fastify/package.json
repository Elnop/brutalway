{
  "name": "template-fastify",
  "version": "0.11.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "prettier": "@brutalway/prettier-config",
  "imports": {
    "#src/*": "./src/*",
    "#test-support/*": "./test/support/*"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc -p .",
    "lint": "oxlint --type-aware src test oxlint.config.ts",
    "deps": "depcruise --output-type err-long '{src,test}/**/*.ts'",
    "tree": "check-tree src",
    "duplicates": "jscpd src",
    "docs": "check-doc-length && check-doc-sources && check-doc-links",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "repo": "alint check",
    "unused": "knip && knip --production",
    "secrets": "check-secrets",
    "exceptions": "check-exceptions",
    "check": "brutal-check",
    "test": "node --test 'test/unit/**/*.test.ts'",
    "prepare": "git config core.hooksPath .githooks"
  },
  "allowScripts": {
    "@swc/core": false,
    "@asamarts/alint@0.22.0": true
  },
  "overrides": {
    "eslint-plugin-no-comments": {
      "minimatch": "^11.0.1"
    }
  },
  "dependencies": {
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.3",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "openapi-types": "12.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@asamarts/alint": "0.22.0",
    "@brutalway/agent-hook": "0.5.0",
    "@brutalway/alint-config": "0.2.4",
    "@brutalway/check": "0.3.0",
    "@brutalway/check-doc-length": "0.2.1",
    "@brutalway/check-doc-links": "0.2.1",
    "@brutalway/check-doc-sources": "0.2.1",
    "@brutalway/check-exceptions": "0.2.1",
    "@brutalway/check-secrets": "0.1.1",
    "@brutalway/check-tree": "0.15.0",
    "@brutalway/dependency-cruiser-config": "0.14.0",
    "@brutalway/oxlint-config-fastify": "0.3.0",
    "@brutalway/oxlint-config-node-test": "0.1.0",
    "@brutalway/prettier-config": "0.3.0",
    "@brutalway/tsconfig": "0.4.0",
    "@swc/core": "1.16.22",
    "@types/node": "26.6.6",
    "dependency-cruiser": "18.7.2",
    "jscpd": "5.4.3",
    "knip": "6.44.2",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}

{
  "name": "template-fastify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "prettier": "@brutalway/prettier-config",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc -p .",
    "lint": "oxlint --type-aware src oxlint.config.ts",
    "deps": "depcruise src",
    "tree": "check-tree src",
    "duplicates": "jscpd src",
    "format": "prettier --write .",
    "check": "prettier --check . && npm run typecheck && npm run lint && npm run deps && npm run tree && npm run duplicates && alint check && knip",
    "test": "node --test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "allowScripts": {
    "@swc/core": false,
    "@asamarts/alint@0.21.0": true
  },
  "overrides": {
    "eslint-plugin-no-comments": {
      "minimatch": "^11.0.1"
    }
  },
  "dependencies": {
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.3",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "openapi-types": "12.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@asamarts/alint": "0.21.0",
    "@brutalway/agent-hook": "0.1.0",
    "@brutalway/alint-config": "0.1.0",
    "@brutalway/check-tree": "0.4.0",
    "@brutalway/dependency-cruiser-config": "0.4.0",
    "@brutalway/oxlint-config-fastify": "0.2.0",
    "@brutalway/oxlint-config-node-test": "0.1.0",
    "@brutalway/prettier-config": "0.1.0",
    "@brutalway/tsconfig": "0.2.0",
    "@swc/core": "1.16.21",
    "@types/node": "26.6.6",
    "dependency-cruiser": "18.7.2",
    "jscpd": "5.4.2",
    "knip": "6.42.1",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}

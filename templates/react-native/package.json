{
  "name": "template-react-native",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "prettier": "@brutalway/prettier-config",
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "phone": "node scripts/phone.ts",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "typecheck": "i18next-cli types --quiet && tsc -p tsconfig.app.json && tsc -p tsconfig.test.json",
    "lint": "oxlint --type-aware src scripts oxlint.config.ts jest.setup.ts i18next.config.ts",
    "deps": "depcruise --output-type err-long src",
    "tree": "check-tree src",
    "duplicates": "jscpd src",
    "docs": "check-doc-length && check-doc-sources && check-doc-links",
    "messages": "i18next-cli status && i18next-cli status --unused",
    "format": "prettier --write .",
    "check": "prettier --check . && npm run typecheck && npm run lint && npm run deps && npm run tree && npm run duplicates && npm run docs && npm run messages && alint check && knip",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepare": "git config core.hooksPath .githooks && i18next-cli types --quiet"
  },
  "dependencies": {
    "@expo-google-fonts/space-grotesk": "0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "58.0.23",
    "expo-constants": "58.0.15",
    "expo-crypto": "58.0.7",
    "expo-dev-client": "58.0.19",
    "expo-font": "58.0.11",
    "expo-linking": "58.0.16",
    "expo-router": "58.0.30",
    "i18next": "27.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "18.0.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-web": "0.21.4",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@asamarts/alint": "0.22.0",
    "@brutalway/agent-hook": "0.2.1",
    "@brutalway/alint-config": "0.2.2",
    "@brutalway/check-doc-length": "0.2.1",
    "@brutalway/check-doc-links": "0.2.1",
    "@brutalway/check-doc-sources": "0.2.1",
    "@brutalway/check-tree": "0.5.1",
    "@brutalway/dependency-cruiser-config": "0.6.0",
    "@brutalway/oxlint-config-i18next": "0.3.0",
    "@brutalway/oxlint-config-react-native": "0.1.0",
    "@brutalway/prettier-config": "0.3.0",
    "@brutalway/tsconfig": "0.4.0",
    "@jest/globals": "30.5.2",
    "@swc/core": "1.16.22",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "dependency-cruiser": "18.7.2",
    "i18next-cli": "1.87.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "jscpd": "5.4.3",
    "knip": "6.44.2",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "@swc/core": false,
    "@asamarts/alint@0.22.0": true
  },
  "overrides": {
    "eslint-plugin-no-comments": {
      "minimatch": "^11.0.1"
    }
  },
  "main": "expo-router/entry",
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript",
        "@types/jest"
      ]
    }
  }
}

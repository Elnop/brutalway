{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "types": ["expo/types", "node", "jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@test-utils/*": ["./test-utils/*"]
    }
  },
  "include": [
    "src",
    "test-utils",
    "node_modules/.cache/i18next",
    "jest.setup.ts",
    "scripts",
    "oxlint.config.ts",
    "i18next.config.ts"
  ],
  "exclude": []
}

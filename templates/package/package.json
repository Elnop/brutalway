{
  "name": "template-package",
  "version": "0.2.0",
  "private": true,
  "description": "A todo list kept in a JSON file, as a library and as the todo command.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "todo": "./dist/todo.js"
  },
  "exports": {
    ".": {
      "types": "./dist/todos.d.ts",
      "default": "./dist/todos.js"
    }
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "prettier": "@brutalway/prettier-config",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p .",
    "lint": "oxlint --type-aware src oxlint.config.ts tsdown.config.ts",
    "deps": "depcruise --output-type err-long src",
    "tree": "check-tree src --root-entries",
    "duplicates": "jscpd src",
    "docs": "check-doc-length && check-doc-sources && check-doc-links",
    "format": "prettier --write .",
    "check": "prettier --check . && npm run typecheck && npm run lint && npm run deps && npm run tree && npm run duplicates && npm run docs && alint check && knip",
    "test": "node --test 'src/**/*.test.ts'",
    "release": "changeset publish",
    "prepack": "npm run build",
    "prepare": "git config core.hooksPath .githooks"
  },
  "allowScripts": {
    "@swc/core": false,
    "@asamarts/alint@0.21.0": true
  },
  "overrides": {
    "eslint-plugin-no-comments": {
      "minimatch": "^11.0.1"
    }
  },
  "devDependencies": {
    "@asamarts/alint": "0.21.0",
    "@brutalway/agent-hook": "0.2.1",
    "@brutalway/alint-config": "0.2.0",
    "@brutalway/check-doc-length": "0.2.1",
    "@brutalway/check-doc-links": "0.2.1",
    "@brutalway/check-doc-sources": "0.2.1",
    "@brutalway/check-tree": "0.5.1",
    "@brutalway/dependency-cruiser-config": "0.5.0",
    "@brutalway/oxlint-config-node": "0.2.1",
    "@brutalway/oxlint-config-node-test": "0.1.0",
    "@brutalway/prettier-config": "0.3.0",
    "@brutalway/tsconfig": "0.4.0",
    "@changesets/cli": "3.0.3",
    "@swc/core": "1.16.22",
    "@types/node": "26.6.6",
    "dependency-cruiser": "18.7.2",
    "jscpd": "5.4.2",
    "knip": "6.44.2",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "prettier": "3.9.10",
    "tsdown": "0.23.7",
    "typescript": "7.0.2"
  }
}

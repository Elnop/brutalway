{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "types": ["node", "@vitest/browser-playwright"],
    "paths": {
      "@/*": ["./src/*"],
      "@locales/*": ["./locales/*"],
      "@test-e2e/*": ["./test/e2e/*"],
      "@test-support/*": ["./test/support/*"]
    }
  },
  "include": [
    "src",
    "test",
    "node_modules/.cache/i18next",
    "next.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "oxlint.config.ts",
    "playwright.config.ts",
    "i18next.config.ts"
  ],
  "exclude": []
}

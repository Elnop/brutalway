{
  "name": "@brutalway/playwright-fixtures",
  "version": "0.2.0",
  "description": "Playwright fixtures: fail a test when the page throws, list axe-core violations.",
  "keywords": [
    "playwright",
    "axe-core",
    "accessibility",
    "e2e"
  ],
  "homepage": "https://github.com/Elnop/brutalway/tree/main/packages/tools/playwright-fixtures#readme",
  "bugs": "https://github.com/Elnop/brutalway/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elnop/brutalway.git",
    "directory": "packages/tools/playwright-fixtures"
  },
  "license": "MIT",
  "author": "elnop",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "files": [
    "dist"
  ],
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": "./dist/playwrightFixtures.js",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p .",
    "lint": "oxlint --type-aware src oxlint.config.ts tsdown.config.ts",
    "deps": "depcruise --output-type err-long src",
    "tree": "check-tree src --root-entries",
    "duplicates": "jscpd src",
    "check": "prettier --check . && npm run typecheck && npm run lint && npm run deps && npm run tree && npm run duplicates && npm run unused",
    "test": "node --test 'src/**/*.test.ts'",
    "format": "prettier --write .",
    "unused": "knip"
  },
  "peerDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@brutalway/check-tree": "0.5.1",
    "@brutalway/dependency-cruiser-config": "0.5.0",
    "@brutalway/oxlint-config-node": "0.2.1",
    "@brutalway/oxlint-config-node-test": "0.1.0",
    "@brutalway/prettier-config": "0.3.0",
    "@brutalway/tsconfig": "0.4.0",
    "@playwright/test": "1.64.1",
    "@swc/core": "1.16.22",
    "@types/node": "26.6.6",
    "dependency-cruiser": "18.7.2",
    "jscpd": "5.4.2",
    "knip": "6.44.2",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "prettier": "3.9.10",
    "tsdown": "0.23.7",
    "typescript": "7.0.2"
  },
  "prettier": "@brutalway/prettier-config",
  "allowScripts": {
    "@swc/core": false
  },
  "overrides": {
    "eslint-plugin-no-comments": {
      "minimatch": "^11.0.1"
    }
  }
}

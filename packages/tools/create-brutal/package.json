{
  "name": "create-brutal",
  "version": "0.10.2",
  "description": "Creates a project from one of the brutalway templates, where every convention is a check.",
  "keywords": [
    "create",
    "template",
    "vite",
    "react",
    "fastify",
    "brutal",
    "conventions",
    "ai-agents"
  ],
  "homepage": "https://github.com/Elnop/brutalway/tree/main/packages/tools/create-brutal#readme",
  "bugs": "https://github.com/Elnop/brutalway/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elnop/brutalway.git",
    "directory": "packages/tools/create-brutal"
  },
  "license": "MIT",
  "author": "elnop",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "files": [
    "dist",
    "overlays"
  ],
  "bin": {
    "create-brutal": "dist/cli.js"
  },
  "scripts": {
    "build": "tsdown && node scripts/writeStackRefs.ts",
    "prepack": "npm run build",
    "typecheck": "tsc -p .",
    "lint": "oxlint --type-aware src scripts oxlint.config.ts tsdown.config.ts",
    "deps": "depcruise --output-type err-long src scripts",
    "tree": "check-tree src --root-entries",
    "duplicates": "jscpd src scripts",
    "check": "prettier --check . && npm run typecheck && npm run lint && npm run deps && npm run tree && npm run duplicates && npm run unused",
    "test": "node --test 'src/**/*.test.ts'",
    "format": "prettier --write .",
    "unused": "knip"
  },
  "dependencies": {
    "@clack/prompts": "1.9.0",
    "giget": "3.3.1"
  },
  "devDependencies": {
    "@brutalway/check-tree": "0.5.1",
    "@brutalway/dependency-cruiser-config": "0.5.0",
    "@brutalway/oxlint-config-node": "0.2.1",
    "@brutalway/oxlint-config-node-test": "0.1.0",
    "@brutalway/prettier-config": "0.3.0",
    "@brutalway/tsconfig": "0.4.0",
    "@swc/core": "1.16.22",
    "@types/node": "26.6.6",
    "dependency-cruiser": "18.7.2",
    "jscpd": "5.4.3",
    "knip": "6.44.2",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "prettier": "3.9.10",
    "tsdown": "0.23.7",
    "typescript": "7.0.2"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "prettier": "@brutalway/prettier-config",
  "allowScripts": {
    "@swc/core": false
  },
  "overrides": {
    "eslint-plugin-no-comments": {
      "minimatch": "^11.0.1"
    }
  }
}

{
  "name": "create-brutal",
  "version": "0.7.0",
  "description": "Creates a project from one of the brutalway templates, where every convention is a check.",
  "keywords": [
    "create",
    "template",
    "vite",
    "react",
    "fastify",
    "brutal",
    "conventions",
    "ai-agents"
  ],
  "homepage": "https://github.com/Elnop/brutalway/tree/main/packages/tools/create-brutal#readme",
  "bugs": "https://github.com/Elnop/brutalway/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elnop/brutalway.git",
    "directory": "packages/tools/create-brutal"
  },
  "license": "MIT",
  "author": "elnop",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "files": [
    "dist",
    "overlays"
  ],
  "bin": {
    "create-brutal": "dist/cli.js"
  },
  "scripts": {
    "build": "tsdown && node scripts/writeStackRefs.ts",
    "prepack": "npm run build",
    "typecheck": "tsc -p .",
    "lint": "oxlint --type-aware src scripts oxlint.config.ts tsdown.config.ts",
    "deps": "depcruise src scripts",
    "tree": "check-tree src --root-entries",
    "duplicates": "jscpd src scripts",
    "check": "npm run typecheck && npm run lint && npm run deps && npm run tree && npm run duplicates",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "giget": "3.3.1"
  },
  "devDependencies": {
    "@brutalway/check-tree": "0.5.0",
    "@brutalway/dependency-cruiser-config": "0.5.0",
    "@brutalway/oxlint-config-node": "0.2.0",
    "@brutalway/oxlint-config-node-test": "0.1.0",
    "@brutalway/tsconfig": "0.3.0",
    "dependency-cruiser": "18.7.2",
    "jscpd": "5.4.2",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsdown": "0.23.5",
    "typescript": "7.0.2"
  },
  "imports": {
    "#src/*": "./src/*"
  }
}

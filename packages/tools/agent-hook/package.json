{
  "name": "@brutalway/agent-hook",
  "version": "0.2.1",
  "description": "Claude Code PostToolUse hook: lints each file the agent edits with oxlint, runs alint and check-tree when a file is created, and sends the errors back to the agent.",
  "keywords": [
    "claude-code",
    "hook",
    "oxlint",
    "alint",
    "agent"
  ],
  "homepage": "https://github.com/Elnop/brutalway/tree/main/packages/tools/agent-hook#readme",
  "bugs": "https://github.com/Elnop/brutalway/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elnop/brutalway.git",
    "directory": "packages/tools/agent-hook"
  },
  "license": "MIT",
  "author": "elnop",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "brutal-agent-hook": "./dist/agentHook.js"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p .",
    "lint": "oxlint --type-aware src oxlint.config.ts tsdown.config.ts",
    "deps": "depcruise --output-type err-long src",
    "tree": "check-tree src --root-entries",
    "duplicates": "jscpd src",
    "check": "npm run typecheck && npm run lint && npm run deps && npm run tree && npm run duplicates",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "devDependencies": {
    "@brutalway/check-tree": "0.5.1",
    "@brutalway/dependency-cruiser-config": "0.5.0",
    "@brutalway/oxlint-config-node": "0.2.1",
    "@brutalway/oxlint-config-node-test": "0.1.0",
    "@brutalway/tsconfig": "0.4.0",
    "dependency-cruiser": "18.7.2",
    "jscpd": "5.4.2",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsdown": "0.23.5",
    "typescript": "7.0.2"
  },
  "imports": {
    "#src/*": "./src/*"
  }
}

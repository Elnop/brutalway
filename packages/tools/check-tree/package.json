{
  "name": "@brutalway/check-tree",
  "version": "0.4.0",
  "description": "Checks a source tree: no empty folder, no category folder holding a single child, stylesheets grouped in styles/.",
  "keywords": [
    "lint",
    "folder-structure",
    "project-structure",
    "cli"
  ],
  "homepage": "https://github.com/Elnop/brutalway/tree/main/packages/tools/check-tree#readme",
  "bugs": "https://github.com/Elnop/brutalway/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elnop/brutalway.git",
    "directory": "packages/tools/check-tree"
  },
  "license": "MIT",
  "author": "elnop",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "check-tree": "./dist/checkTree.js"
  },
  "exports": {
    "./treeViolations": "./dist/treeViolations.js"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p .",
    "lint": "oxlint --type-aware src oxlint.config.ts tsdown.config.ts",
    "deps": "depcruise src",
    "tree": "node src/checkTree.ts src",
    "duplicates": "jscpd src",
    "check": "npm run typecheck && npm run lint && npm run deps && npm run tree && npm run duplicates",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "devDependencies": {
    "@brutalway/dependency-cruiser-config": "0.4.0",
    "@brutalway/oxlint-config-node": "0.1.0",
    "@brutalway/oxlint-config-node-test": "0.1.0",
    "@brutalway/tsconfig": "0.2.0",
    "dependency-cruiser": "18.7.2",
    "jscpd": "5.4.2",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsdown": "0.23.5",
    "typescript": "7.0.2"
  },
  "imports": {
    "#src/*": "./src/*"
  }
}

{
  "name": "@brutalway/check-doc-links",
  "version": "0.2.0",
  "description": "Fails when a Markdown doc links to a page that no longer exists, and skips the check when the machine is offline.",
  "keywords": [
    "markdown",
    "docs",
    "links",
    "lint",
    "cli"
  ],
  "homepage": "https://github.com/Elnop/brutalway/tree/main/packages/tools/check-doc-links#readme",
  "bugs": "https://github.com/Elnop/brutalway/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elnop/brutalway.git",
    "directory": "packages/tools/check-doc-links"
  },
  "license": "MIT",
  "author": "elnop",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "check-doc-links": "./dist/checkDocLinks.js"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p .",
    "lint": "oxlint --type-aware src oxlint.config.ts tsdown.config.ts",
    "deps": "depcruise src",
    "tree": "check-tree src --root-entries",
    "duplicates": "jscpd src",
    "check": "npm run typecheck && npm run lint && npm run deps && npm run tree && npm run duplicates",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0"
  },
  "devDependencies": {
    "@brutalway/check-tree": "0.5.0",
    "@brutalway/dependency-cruiser-config": "0.5.0",
    "@brutalway/oxlint-config-node": "0.2.0",
    "@brutalway/oxlint-config-node-test": "0.1.0",
    "@brutalway/tsconfig": "0.3.0",
    "@types/mdast": "4.0.4",
    "dependency-cruiser": "18.7.2",
    "jscpd": "5.4.2",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsdown": "0.23.5",
    "typescript": "7.0.2"
  },
  "imports": {
    "#src/*": "./src/*"
  }
}

{
  "name": "@brutalway/check-doc-length",
  "version": "0.2.1",
  "description": "Fails when a Markdown file gets too long, and splits it into a folder along its headings, rewriting the links that point into it.",
  "keywords": [
    "markdown",
    "docs",
    "lint",
    "split",
    "cli"
  ],
  "homepage": "https://github.com/Elnop/brutalway/tree/main/packages/tools/check-doc-length#readme",
  "bugs": "https://github.com/Elnop/brutalway/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elnop/brutalway.git",
    "directory": "packages/tools/check-doc-length"
  },
  "license": "MIT",
  "author": "elnop",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "check-doc-length": "./dist/checkDocLength.js"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p .",
    "lint": "oxlint --type-aware src oxlint.config.ts tsdown.config.ts",
    "deps": "depcruise --output-type err-long src",
    "tree": "check-tree src --root-entries",
    "duplicates": "jscpd src",
    "check": "prettier --check . && npm run typecheck && npm run lint && npm run deps && npm run tree && npm run duplicates && npm run unused",
    "test": "node --test 'src/**/*.test.ts'",
    "format": "prettier --write .",
    "unused": "knip"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-string": "^4.0.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0"
  },
  "devDependencies": {
    "@brutalway/check-tree": "0.5.1",
    "@brutalway/dependency-cruiser-config": "0.5.0",
    "@brutalway/oxlint-config-node": "0.2.1",
    "@brutalway/oxlint-config-node-test": "0.1.0",
    "@brutalway/prettier-config": "0.3.0",
    "@brutalway/tsconfig": "0.4.0",
    "@swc/core": "1.16.22",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.6",
    "dependency-cruiser": "18.7.2",
    "jscpd": "5.4.2",
    "knip": "6.44.2",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "prettier": "3.9.10",
    "tsdown": "0.23.7",
    "typescript": "7.0.2"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "prettier": "@brutalway/prettier-config",
  "allowScripts": {
    "@swc/core": false
  },
  "overrides": {
    "eslint-plugin-no-comments": {
      "minimatch": "^11.0.1"
    }
  }
}

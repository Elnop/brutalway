{
  "name": "@brutalway/lint-utils",
  "version": "0.1.0",
  "description": "Helpers shared by the @brutalway lint configs and plugins: export listing, file base name, oxlint rule and fixture testers, oklab colors and color token reading.",
  "keywords": [
    "oxlint",
    "eslint",
    "lint",
    "oklab"
  ],
  "homepage": "https://github.com/Elnop/brutalway/tree/main/packages/utils/lint-utils#readme",
  "bugs": "https://github.com/Elnop/brutalway/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elnop/brutalway.git",
    "directory": "packages/utils/lint-utils"
  },
  "license": "MIT",
  "author": "elnop",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "files": [
    "dist"
  ],
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    "./baseName": "./dist/baseName.js",
    "./exportsOf": "./dist/exportsOf.js",
    "./ExportTypes": "./dist/ExportTypes.js",
    "./ruleTester": "./dist/ruleTester.js",
    "./lintFixture": "./dist/lintFixture.js",
    "./OxlintReportTypes": "./dist/OxlintReportTypes.js",
    "./oklab": "./dist/oklab.js",
    "./createColorTokenReader": "./dist/createColorTokenReader.js",
    "./ColorTypes": "./dist/ColorTypes.js"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p .",
    "lint": "oxlint --type-aware src oxlint.config.ts tsdown.config.ts",
    "deps": "depcruise --output-type err-long src",
    "tree": "check-tree src --root-entries",
    "duplicates": "jscpd src",
    "check": "npm run typecheck && npm run lint && npm run deps && npm run tree && npm run duplicates",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.91.0"
  },
  "peerDependencies": {
    "oxlint": "^1.91.0"
  },
  "devDependencies": {
    "@brutalway/check-tree": "0.5.1",
    "@brutalway/dependency-cruiser-config": "0.5.0",
    "@brutalway/oxlint-config-node": "0.2.1",
    "@brutalway/oxlint-config-node-test": "0.1.0",
    "@brutalway/tsconfig": "0.4.0",
    "dependency-cruiser": "18.7.2",
    "jscpd": "5.4.2",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsdown": "0.23.5",
    "typescript": "7.0.2"
  }
}

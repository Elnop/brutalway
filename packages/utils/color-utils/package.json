{
  "name": "@brutalway/color-utils",
  "version": "0.1.0",
  "private": true,
  "description": "Color code shared by the @brutalway Tailwind and Stylelint configs: oklab conversion and distance, cached reading of the color tokens of a stylesheet.",
  "keywords": [
    "color",
    "oklab",
    "lint"
  ],
  "homepage": "https://github.com/Elnop/brutalway/tree/main/packages/utils/color-utils#readme",
  "bugs": "https://github.com/Elnop/brutalway/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elnop/brutalway.git",
    "directory": "packages/utils/color-utils"
  },
  "license": "MIT",
  "author": "elnop",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "files": [
    "dist"
  ],
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    "./oklab": "./dist/oklab.js",
    "./createColorTokenReader": "./dist/createColorTokenReader.js",
    "./ColorTypes": "./dist/ColorTypes.js"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p .",
    "lint": "oxlint --type-aware src oxlint.config.ts tsdown.config.ts",
    "deps": "depcruise --output-type err-long src",
    "tree": "check-tree src --root-entries",
    "duplicates": "jscpd src",
    "check": "npm run typecheck && npm run lint && npm run deps && npm run tree && npm run duplicates",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "devDependencies": {
    "@brutalway/check-tree": "0.5.1",
    "@brutalway/dependency-cruiser-config": "0.5.0",
    "@brutalway/oxlint-config-node": "0.2.1",
    "@brutalway/oxlint-config-node-test": "0.1.0",
    "@brutalway/tsconfig": "0.4.0",
    "dependency-cruiser": "18.7.2",
    "jscpd": "5.4.2",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsdown": "0.23.5",
    "typescript": "7.0.2"
  }
}

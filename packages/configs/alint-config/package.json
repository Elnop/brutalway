{
  "name": "@brutalway/alint-config",
  "version": "0.2.0",
  "description": "alint rules for a repository: category folders hold only their kind, every dependency is pinned (only devDependencies for a published library), doc links and anchors resolve.",
  "keywords": [
    "alint",
    "repository",
    "lint"
  ],
  "homepage": "https://github.com/Elnop/brutalway/tree/main/packages/configs/alint-config#readme",
  "bugs": "https://github.com/Elnop/brutalway/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elnop/brutalway.git",
    "directory": "packages/configs/alint-config"
  },
  "license": "MIT",
  "author": "elnop",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "files": [
    "base.yml",
    "library.yml"
  ],
  "scripts": {
    "test": "node --test '**/*.test.ts'",
    "format": "prettier --write .",
    "unused": "knip",
    "check": "prettier --check . && npm run unused"
  },
  "peerDependencies": {
    "@asamarts/alint": "^0.21.0"
  },
  "devDependencies": {
    "@asamarts/alint": "0.21.0",
    "@brutalway/prettier-config": "0.3.0",
    "knip": "6.44.2",
    "prettier": "3.9.10"
  },
  "prettier": "@brutalway/prettier-config",
  "allowScripts": {
    "@asamarts/alint@0.21.0": true
  }
}

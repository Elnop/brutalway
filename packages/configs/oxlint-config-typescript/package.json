{
  "name": "@brutalway/oxlint-config-typescript",
  "version": "0.4.0",
  "description": "Oxlint config for TypeScript projects: no comments, no barrel files, files named after their export, types and constants in dedicated files.",
  "keywords": [
    "oxlint",
    "oxlint-config",
    "typescript",
    "lint"
  ],
  "homepage": "https://github.com/Elnop/brutalway/tree/main/packages/configs/oxlint-config-typescript#readme",
  "bugs": "https://github.com/Elnop/brutalway/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elnop/brutalway.git",
    "directory": "packages/configs/oxlint-config-typescript"
  },
  "license": "MIT",
  "author": "elnop",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "files": [
    "dist"
  ],
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": "./dist/TypescriptConfig.js",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p .",
    "lint": "oxlint --type-aware src oxlint.config.ts tsdown.config.ts",
    "deps": "depcruise src",
    "tree": "check-tree src --root-entries",
    "duplicates": "jscpd src",
    "check": "npm run typecheck && npm run lint && npm run deps && npm run tree && npm run duplicates",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@brutalway/eslint-plugin-file-named-after-export": "^0.1.2",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-no-comments": "1.2.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "oxlint-plugin-eslint": "^1.91.0"
  },
  "peerDependencies": {
    "oxlint": "^1.91.0"
  },
  "devDependencies": {
    "@brutalway/check-tree": "0.4.0",
    "@brutalway/dependency-cruiser-config": "0.4.0",
    "@brutalway/lint-utils": "0.1.0",
    "@brutalway/oxlint-config-node-test": "0.1.0",
    "@brutalway/tsconfig": "0.2.0",
    "dependency-cruiser": "18.7.2",
    "jscpd": "5.4.2",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsdown": "0.23.5",
    "typescript": "7.0.2"
  }
}

{
  "name": "@brutalway/oxlint-config-fastify",
  "version": "0.2.1",
  "description": "Oxlint config for Fastify APIs with Zod: env read in one place, dependencies passed to factories, async handlers that return, Zod schemas in XSchemas.ts, no route in shared-features/.",
  "keywords": [
    "oxlint",
    "oxlint-config",
    "fastify",
    "zod",
    "lint"
  ],
  "homepage": "https://github.com/Elnop/brutalway/tree/main/packages/configs/oxlint-config-fastify#readme",
  "bugs": "https://github.com/Elnop/brutalway/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elnop/brutalway.git",
    "directory": "packages/configs/oxlint-config-fastify"
  },
  "license": "MIT",
  "author": "elnop",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "files": [
    "dist"
  ],
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": "./dist/FastifyConfig.js",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p .",
    "lint": "oxlint --type-aware src oxlint.config.ts tsdown.config.ts",
    "deps": "depcruise --output-type err-long src",
    "tree": "check-tree src --root-entries",
    "duplicates": "jscpd src",
    "check": "npm run typecheck && npm run lint && npm run deps && npm run tree && npm run duplicates",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@brutalway/oxlint-config-node": "^0.2.0",
    "oxlint-plugin-eslint": "^1.91.0"
  },
  "peerDependencies": {
    "oxlint": "^1.91.0"
  },
  "devDependencies": {
    "@brutalway/check-tree": "0.5.0",
    "@brutalway/dependency-cruiser-config": "0.5.0",
    "@brutalway/lint-utils": "0.1.0",
    "@brutalway/oxlint-config-node-test": "0.1.0",
    "@brutalway/tsconfig": "0.3.0",
    "dependency-cruiser": "18.7.2",
    "jscpd": "5.4.2",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsdown": "0.23.5",
    "typescript": "7.0.2"
  }
}

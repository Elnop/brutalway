{
  "name": "@brutalway/prettier-config",
  "version": "0.3.0",
  "description": "Prettier config: single quotes, trailing commas, 200 columns, and a variant that sorts Tailwind classes.",
  "keywords": [
    "prettier",
    "prettier-config",
    "tailwindcss"
  ],
  "homepage": "https://github.com/Elnop/brutalway/tree/main/packages/configs/prettier-config#readme",
  "bugs": "https://github.com/Elnop/brutalway/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elnop/brutalway.git",
    "directory": "packages/configs/prettier-config"
  },
  "license": "MIT",
  "author": "elnop",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "files": [
    "prettierConfig.json",
    "prettierConfigTailwind.json"
  ],
  "exports": {
    ".": "./prettierConfig.json",
    "./tailwind": "./prettierConfigTailwind.json"
  },
  "scripts": {
    "test": "node --test '**/*.test.ts'",
    "format": "prettier --write .",
    "unused": "knip",
    "check": "prettier --check . && npm run unused"
  },
  "peerDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "peerDependenciesMeta": {
    "prettier-plugin-tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "knip": "6.45.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5"
  },
  "prettier": "./prettierConfig.json"
}

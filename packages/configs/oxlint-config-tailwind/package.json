{
  "name": "@brutalway/oxlint-config-tailwind",
  "version": "0.1.0",
  "description": "Oxlint config for Tailwind CSS v4: colors only from the @theme tokens, font roles on headings and code, no dark: variant.",
  "keywords": [
    "oxlint",
    "oxlint-config",
    "oxlint-plugin",
    "tailwindcss",
    "design-tokens",
    "lint"
  ],
  "homepage": "https://github.com/Elnop/brutalway/tree/main/packages/configs/oxlint-config-tailwind#readme",
  "bugs": "https://github.com/Elnop/brutalway/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elnop/brutalway.git",
    "directory": "packages/configs/oxlint-config-tailwind"
  },
  "license": "MIT",
  "author": "elnop",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "files": [
    "dist"
  ],
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": "./dist/TailwindConfig.js",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p .",
    "lint": "oxlint --type-aware src oxlint.config.ts tsdown.config.ts",
    "deps": "depcruise src",
    "tree": "check-tree src",
    "duplicates": "jscpd src",
    "check": "npm run typecheck && npm run lint && npm run deps && npm run tree && npm run duplicates",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.91.0"
  },
  "peerDependencies": {
    "oxlint": "^1.91.0"
  },
  "devDependencies": {
    "@brutalway/check-tree": "0.4.0",
    "@brutalway/dependency-cruiser-config": "0.4.0",
    "@brutalway/lint-utils": "0.1.0",
    "@brutalway/oxlint-config-node": "0.1.0",
    "@brutalway/oxlint-config-node-test": "0.1.0",
    "@brutalway/tsconfig": "0.2.0",
    "dependency-cruiser": "18.7.2",
    "jscpd": "5.4.2",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "tailwindcss": "4.3.3",
    "tsdown": "0.23.5",
    "typescript": "7.0.2"
  }
}

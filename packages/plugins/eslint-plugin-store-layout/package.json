{
  "name": "@brutalway/eslint-plugin-store-layout",
  "version": "0.1.3",
  "description": "Lint rule for oxlint and ESLint: xStore.ts only exports xStore and xActions.",
  "keywords": [
    "oxlint",
    "oxlint-plugin",
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "zustand",
    "store"
  ],
  "homepage": "https://github.com/Elnop/brutalway/tree/main/packages/plugins/eslint-plugin-store-layout#readme",
  "bugs": "https://github.com/Elnop/brutalway/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elnop/brutalway.git",
    "directory": "packages/plugins/eslint-plugin-store-layout"
  },
  "license": "MIT",
  "author": "elnop",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "files": [
    "dist"
  ],
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": "./dist/plugin.js",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p .",
    "lint": "oxlint --type-aware src oxlint.config.ts tsdown.config.ts",
    "deps": "depcruise src",
    "tree": "check-tree src --root-entries",
    "duplicates": "jscpd src",
    "check": "npm run typecheck && npm run lint && npm run deps && npm run tree && npm run duplicates",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.91.0"
  },
  "peerDependencies": {
    "oxlint": "^1.91.0"
  },
  "devDependencies": {
    "@brutalway/check-tree": "0.5.0",
    "@brutalway/dependency-cruiser-config": "0.5.0",
    "@brutalway/lint-utils": "^0.1.0",
    "@brutalway/oxlint-config-node": "0.2.0",
    "@brutalway/oxlint-config-node-test": "0.1.0",
    "@brutalway/tsconfig": "0.3.0",
    "dependency-cruiser": "18.7.2",
    "jscpd": "5.4.2",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsdown": "0.23.5",
    "typescript": "7.0.2"
  }
}

{
  "name": "brutalway",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "prettier": "@brutalway/prettier-config",
  "scripts": {
    "bootstrap": "npm ci && npm ci --prefix packages && npm ci --prefix templates && node scripts/eachPackage.ts ci",
    "build": "node scripts/eachPackage.ts run build --if-present",
    "typecheck": "tsc -p .",
    "lint": "oxlint --type-aware --disable-nested-config",
    "format": "prettier --write .",
    "docs": "check-doc-length && check-doc-sources && check-doc-links",
    "check": "prettier --check . && npm run typecheck && npm run lint && node scripts/eachPackage.ts run check --if-present && npm run docs && knip && npm test",
    "test": "node scripts/eachPackage.ts test --if-present && node --test 'scripts/**/*.test.ts'",
    "matrix": "node packages/tools/create-brutal/scripts/runMatrix.ts",
    "changeset": "npm run changeset --prefix packages",
    "version": "npm run version --prefix packages && node scripts/eachPackage.ts install --package-lock-only --ignore-scripts",
    "templates:changeset": "npm run changeset --prefix templates",
    "templates:version": "npm run version --prefix templates",
    "release": "npm run build && npm run check && npm run release --prefix packages && npm run tag --prefix templates && git push --follow-tags && node scripts/createReleases.ts"
  },
  "devDependencies": {
    "@brutalway/check-doc-length": "0.2.1",
    "@brutalway/check-doc-links": "0.2.1",
    "@brutalway/check-doc-sources": "0.2.1",
    "@brutalway/oxlint-config-typescript": "0.6.0",
    "@brutalway/prettier-config": "0.3.0",
    "@types/node": "26.6.6",
    "knip": "6.44.2",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "overrides": {
    "eslint-plugin-no-comments": {
      "minimatch": "^11.0.1"
    }
  },
  "allowScripts": {
    "@asamarts/alint@0.22.0": true,
    "@swc/core": false
  },
  "docLength": {
    "ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/CHANGELOG.md",
      "**/fixtures/**",
      "**/test-results/**"
    ]
  },
  "docLinks": {
    "skip": [
      "^https://www\\.npmjs\\.com/package/@brutalway/oxlint-config-(next|react-native)$"
    ],
    "ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/CHANGELOG.md",
      "**/fixtures/**",
      "**/test-results/**"
    ]
  },
  "docSources": {
    "ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/CHANGELOG.md",
      "**/fixtures/**",
      "**/test-results/**"
    ]
  }
}

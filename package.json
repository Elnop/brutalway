{
  "name": "brutalway",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "packages/*/*"
  ],
  "prettier": "@brutalway/prettier-config",
  "scripts": {
    "build": "node scripts/buildPackages.ts",
    "typecheck": "tsc -p .",
    "lint": "oxlint --type-aware --disable-nested-config",
    "format": "prettier --write .",
    "docs": "check-doc-length && check-doc-sources && check-doc-links",
    "check": "prettier --check . && npm run typecheck && npm run lint && npm run check --workspaces --if-present && npm run docs && knip && npm test",
    "test": "npm test --workspaces --if-present && node --test 'scripts/**/*.test.ts'",
    "matrix": "node packages/tools/create-brutal/scripts/runMatrix.ts",
    "templates:changeset": "cd templates && changeset",
    "templates:version": "cd templates && changeset version",
    "release": "npm run build && npm run check && changeset publish && (cd templates && changeset git-tag) && git push --follow-tags && node scripts/createReleases.ts"
  },
  "devDependencies": {
    "@brutalway/check-doc-length": "0.1.0",
    "@brutalway/check-doc-links": "0.1.0",
    "@brutalway/check-doc-sources": "0.1.0",
    "@brutalway/oxlint-config-typescript": "0.4.0",
    "@brutalway/prettier-config": "0.2.0",
    "@changesets/cli": "3.0.3",
    "@types/node": "26.6.6",
    "knip": "6.44.1",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "tsdown": "0.23.5",
    "typescript": "7.0.2"
  },
  "overrides": {
    "eslint-plugin-no-comments": {
      "minimatch": "^11.0.1"
    }
  },
  "allowScripts": {
    "@asamarts/alint@0.21.0": true,
    "@swc/core": false
  },
  "docLength": {
    "ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/CHANGELOG.md",
      "**/fixtures/**",
      "**/test-results/**"
    ]
  },
  "docLinks": {
    "ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/CHANGELOG.md",
      "**/fixtures/**",
      "**/test-results/**"
    ]
  },
  "docSources": {
    "ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/CHANGELOG.md",
      "**/fixtures/**",
      "**/test-results/**",
      "docs/roadmap/**"
    ]
  }
}

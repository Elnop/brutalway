{
  "name": "brutalway",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "prettier": "@brutalway/prettier-config",
  "scripts": {
    "bootstrap": "npm ci && npm ci --prefix packages && npm ci --prefix templates && node scripts/eachPackage.ts ci",
    "build": "node scripts/eachPackage.ts run build --if-present",
    "typecheck": "tsc -p .",
    "lint": "oxlint --type-aware --disable-nested-config",
    "format": "prettier --write .",
    "docs": "check-doc-length && check-doc-sources && check-doc-links",
    "check": "node scripts/check.ts",
    "test": "node scripts/eachPackage.ts test --if-present && node --test 'scripts/**/*.test.ts'",
    "matrix": "node packages/tools/create-brutal/scripts/runMatrix.ts",
    "packages:changeset": "npm run changeset --prefix packages",
    "version": "npm run packages:version && npm run templates:version",
    "packages:version": "node scripts/versionPending.ts packages && node scripts/eachPackage.ts install --package-lock-only --ignore-scripts",
    "templates:changeset": "npm run changeset --prefix templates",
    "templates:version": "node scripts/versionPending.ts templates",
    "release": "node scripts/release.ts"
  },
  "devDependencies": {
    "@brutalway/check-doc-length": "0.2.1",
    "@brutalway/check-doc-links": "0.2.1",
    "@brutalway/check-doc-sources": "0.2.1",
    "@brutalway/oxlint-config-typescript": "0.6.0",
    "@brutalway/prettier-config": "0.3.0",
    "@types/node": "26.6.10",
    "knip": "6.48.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  },
  "overrides": {
    "eslint-plugin-no-comments": {
      "minimatch": "^11.0.1"
    }
  },
  "allowScripts": {
    "@asamarts/alint@0.22.0": true,
    "@swc/core": false
  },
  "docLength": {
    "ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/CHANGELOG.md",
      "**/fixtures/**",
      "**/test-results/**"
    ]
  },
  "docLinks": {
    "ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/CHANGELOG.md",
      "**/fixtures/**",
      "**/test-results/**"
    ]
  },
  "docSources": {
    "ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/CHANGELOG.md",
      "**/fixtures/**",
      "**/test-results/**"
    ]
  }
}

{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$CLAUDE_PROJECT_DIR/node_modules/.bin/brutal-agent-hook\" ]; then exec \"$CLAUDE_PROJECT_DIR/node_modules/.bin/brutal-agent-hook\"; fi",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
